              <property name="styleSheet">
               <string notr="true">QPushButton {
    background-color: #3498db; /* 默认背景色：蓝色 */
    color: white;              /* 文字颜色：白色 */
    border-radius: 5px;        /* 圆角 */
    border: none;              /* 取消默认边框 */
    padding: 5px;              /* 内边距 */
}

/* 2. 鼠标悬停状态（鼠标移上去但没按下） */
QPushButton:hover {
    background-color: #2980b9; /* 颜色略微加深 */
}

/* 3. 按钮按下状态（核心） */
QPushButton:pressed {
    background-color: #1f618d; /* 颜色变得更深 */
    padding-top: 7px;          /* 增加顶部内边距 */
    padding-left: 7px;         /* 增加左侧内边距 */
}
</string>
